{
  "name": "wakatime-bot",
  "version": "1.1.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:bot": "NODE_NO_WARNINGS=1 node --env-file=.env --watch ./src/main.ts bot",
    "dev:api": "NODE_NO_WARNINGS=1 node --env-file=.env --watch ./src/main.ts api",
    "lint": "eslint . --fix",
    "test": "node --test \"src/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@fullstacksjs/toolbox": "4.25.1",
    "awilix": "13.0.5",
    "dedent": "1.7.2",
    "deepmerge-ts": "8.0.2",
    "grammy": "1.46.0",
    "h3": "2.0.8",
    "lowdb": "7.0.1",
    "node-cron": "4.6.0",
    "puppeteer": "25.16.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@fullstacksjs/eslint-config": "15.4.0",
    "@fullstacksjs/tsconfig": "2.0.0",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "volta": {
    "node": "26.13.0"
  }
}
