# Bot
## Bot token from BotFather
BOT_TOKEN=
## Webhook url for bot
BOT_WEBHOOK_URL=
## Port for bot server to listen to (default is 3000)
BOT_PORT=
## Report id for bot
BOT_REPORT_ID=
## Telegram Admin ID
BOT_ADMIN_ID=
## Api endpoint
BOT_API_ENDPOINT=
## Group chat id the nightly /day report is sent to
BOT_DEFAULT_CHAT_ID=
## Topic (message thread) id within that group the nightly report is sent to
BOT_DEFAULT_TOPIC_ID=

# API
## Port for API to listen to (default is 4000)
API_PORT=
## TOKEN FOR API AUTH
API_TOKEN=

# Wakatime
## OAuth access token with the read_private_leaderboards scope (API keys are write-only).
## Create an app at https://wakatime.com/apps, then follow the steps in the README.
WAKATIME_ACCESS_TOKEN=
## OAuth app credentials, only used by `pnpm run wakatime:token` to get the access token above
WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=
## Optional, defaults to https://wakatime.com/oauth/test
WAKATIME_REDIRECT_URI=
## Leaderboard url
WAKATIME_LEADERBOARD_URL=https://api.wakatime.com/api/v1/users/current/leaderboards/bf50f418-a6b5-4d3f-8147-6115d95ac4c6
## Web page url
WAKATIME_PAGE_URL=http://www.example.com/

# Puppeteer executable path
PUPPETEER_EXECUTABLE_PATH=
